<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hệ Thống Ghi Hình</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="WebGhiHinh.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <HeadOutlet />
</head>
<body>

    <!-- ✅ ROUTING .NET 8 -->
    <Routes />

    <!-- ✅ BẮT BUỘC .NET 8 -->
    <script src="_framework/blazor.web.js"></script>

    <!-- JS LIBS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- JS LOCAL -->
    <script src="js/scan-hls.js"></script>
    <script src="js/station-guard.js"></script>
    <script src="js/scan-overlay.js"></script>
    <script>
    const peers = {};

    window.startWhep = async (videoId, url) => {
        const video = document.getElementById(videoId);
        const pc = new RTCPeerConnection();
        peers[videoId] = pc;

        // 1. Nhận track video/audio từ server
        pc.addTransceiver('video', { direction: 'recvonly' });

        pc.ontrack = (event) => {
            video.srcObject = event.streams[0];
        };

        // 2. Tạo Offer
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);

        // 3. Gửi lên MediaMTX (WHEP Protocol)
        const res = await fetch(url, {
            method: 'POST',
            body: offer.sdp,
            headers: {
                'Content-Type': 'application/sdp'
            }
        });

        // 4. Nhận Answer
        const answer = await res.text();
        await pc.setRemoteDescription(new RTCSessionDescription({
            type: 'answer',
            sdp: answer
        }));
    };

    window.stopWhep = (videoId) => {
        if (peers[videoId]) {
            peers[videoId].close();
            delete peers[videoId];
        }
    };
</script>

</body>
</html>
