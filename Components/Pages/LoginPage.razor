@page "/login"
@layout Layout.LoginLayout 
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav

<PageTitle>Đăng nhập</PageTitle>

<div class="login-page">
    <div class="tech-marquee-container">
        <div class="tech-marquee-text">
            @for (int i = 0; i < 12; i++)
            {
                <span>HOPLONG TECH</span>
            }
        </div>
    </div>

    <div class="login-card">
        <h1 class="login-title">Đăng nhập</h1>

        <form action="/account/login" method="post">
            
            <AntiforgeryToken />

            <div class="input-group">
                <input name="username" class="login-input" placeholder="Tên đăng nhập" required />
            </div>

            <div class="input-group">
                <input name="password" type="password" class="login-input" placeholder="Mật khẩu" required />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="login-error" 
                     style="background:#fee2e2; padding:10px; border-radius:8px; border:1px solid #ef4444; color: #991b1b; margin-top: 15px; font-size: 0.9rem;">
                    ⚠️ @ErrorMessage
                </div>
            }

            <button class="btn" type="submit" style="margin-top: 25px;">
                <span>Đăng nhập</span>
            </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.95rem;">
            <span style="color: #6b7280;">Bạn chưa có tài khoản?</span>
            <a href="/register" 
               style="color: #3b82f6; text-decoration: none; font-weight: 600; margin-left: 5px; transition: color 0.2s;">
                ĐĂNG KÝ NGAY
            </a>
        </div>
    </div>
</div>

@code {
    // 👇 Nhận thông báo lỗi từ URL 
    // Ví dụ khi Controller trả về: /login?error=Sai tài khoản hoặc mật khẩu
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }
}