@page "/live"
@using Microsoft.AspNetCore.SignalR.Client
@using WebGhiHinh.DTOs
@using WebGhiHinh.Services
@using WebGhiHinh.Components.Shared
@using Microsoft.AspNetCore.Http.Connections
@inject StationService StationService
@inject NavigationManager Nav
@implements IAsyncDisposable

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Live Control Center</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid p-3 main-container">

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 col-xl">
            <div class="card bg-primary text-white h-100 shadow-sm border-0">
                <div class="card-body p-2 d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-buildings-fill"></i></div>
                    <div>
                        <div class="small opacity-75 fw-bold">TỔNG MÁY</div>
                        <div class="fs-4 fw-bold">@(stations?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-6 col-md-3 col-xl">
            <div class="card bg-danger text-white h-100 shadow-sm border-0">
                <div class="card-body p-2 d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-record-circle-fill animate-blink"></i></div>
                    <div>
                        <div class="small opacity-75 fw-bold">ĐANG QUAY</div>
                        <div class="fs-4 fw-bold">@(stations?.Count(s => s.IsRecording) ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3 col-xl">
            <div class="card bg-warning text-dark h-100 shadow-sm border-0">
                <div class="card-body p-2 d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-qr-code-scan"></i></div>
                    <div>
                        <div class="small opacity-75 fw-bold">QR THÀNH CÔNG</div>
                        <div class="fs-4 fw-bold">@qrCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3 col-xl">
            <div class="card bg-info text-dark h-100 shadow-sm border-0">
                <div class="card-body p-2 d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-activity"></i></div>
                    <div>
                        <div class="small opacity-75 fw-bold">CHẾ ĐỘ</div>
                        <div class="fs-4 fw-bold">Realtime (WHEP)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-secondary py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="text-white-50">Đang kết nối hệ thống...</p>
        </div>
    }
    else if (stations != null)
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4 fade-in">
            @foreach (var st in stations)
            {
                <div class="col">
                    <div class="card h-100 shadow station-card @(st.IsRecording ? "recording-active" : "border-0 bg-dark")">

                        <div class="card-header border-0 py-2 d-flex justify-content-between align-items-center @(st.IsRecording ? "bg-danger" : "bg-gradient-header")">
                            
                            <span class="text-white fw-bold d-flex align-items-center text-truncate">
                                <i class="bi bi-hdd-network me-2"></i>@(st.Name ?? "Unknown")
                            </span>

                            <div class="d-flex align-items-center gap-2">
                                
                                @* 🔥 NHÃN REC: Chỉ hiện khi đang quay *@
                                @if (st.IsRecording)
                                {
                                    <span class="badge bg-white text-danger fw-bold shadow-sm animate-blink d-flex align-items-center">
                                        <i class="bi bi-record-circle-fill me-1"></i> REC
                                    </span>
                                }

                                @* Hiển thị User *@
                                @if (!string.IsNullOrEmpty(st.CurrentUsername) && st.CurrentUsername != "---")
                                {
                                    <span class="badge bg-dark bg-opacity-25 shadow-sm border border-light">
                                        <i class="bi bi-person-fill me-1"></i> @st.CurrentUsername
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary opacity-50 small">Chưa đăng nhập</span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <div class="row g-0">
                                <div class="col-6 border-end border-secondary">
                                    <div class="cam-box @(st.OverviewCamera != null ? "online" : "offline")">
                                        <div class="cam-badge">TOÀN CẢNH</div>
                                        @if (st.OverviewCamera != null)
                                        {
                                            <WhepVideo src="@($"{whepBaseUrl}/{st.OverviewCamera.Name}/whep")"></WhepVideo>
                                        }
                                        else { <div class="no-signal"><span>NO SIGNAL</span></div> }
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="cam-box @(st.QrCamera != null ? "online" : "offline")">
                                        <div class="cam-badge">QR CAM</div>
                                        @if (st.QrCamera != null)
                                        {
                                            <WhepVideo src="@($"{whepBaseUrl}/{st.QrCamera.Name}/whep")"></WhepVideo>

                                            <svg class="qr-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                                                @if (overlayBoxes.TryGetValue(st.QrCamera.Name, out var box) && box.IsVisible)
                                                {
                                                    <rect x="@box.X" y="@box.Y" width="@box.W" height="@box.H"
                                                          fill="none"
                                                          stroke="@(box.IsSuccess ? "#22c55e" : "#f59e0b")"
                                                          stroke-width="1.5"
                                                          vector-effect="non-scaling-stroke"
                                                          class="@(box.IsSuccess ? "anim-success" : "anim-scan")" />
                                                    <g>
                                                        <svg:text x="@box.X" y="@(box.Y - 1)" fill="white" font-size="5" font-weight="bold">@box.Text</svg:text>
                                                    </g>
                                                }
                                            </svg>
                                        }
                                        else { <div class="no-signal"><span>NO CONFIG</span></div> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    :root { --bg-dark: #0f172a; --card-bg: #1e293b; }
    body { background-color: var(--bg-dark); }
    .main-container { min-height: 100vh; color: #e2e8f0; }
    .bg-gradient-header { background: linear-gradient(90deg, #1e40af 0%, #3b82f6 100%); transition: all 0.3s; }
    .station-card { background-color: var(--card-bg) !important; overflow: hidden; transition: all 0.3s; }

    /* 🔥 Style REC Active: Viền đỏ rực */
    .recording-active {
        border: 2px solid #dc3545 !important;
        box-shadow: 0 0 15px rgba(220, 53, 69, 0.6) !important;
    }

    /* Hiệu ứng nhấp nháy cho chữ REC */
    .animate-blink { animation: blink 1s infinite; }
    @@keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }

    .cam-box { position: relative; width: 100%; aspect-ratio: 4/3; background: #000; overflow: hidden; }
    ::deep video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: fill !important; background-color: #000; }
    .no-signal { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #ef4444; font-weight: bold; font-size: 0.8rem; }
    .cam-badge { position: absolute; top: 4px; left: 4px; z-index: 5; background: rgba(0, 0, 0, 0.7); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; }
    .qr-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none; }
    .anim-scan { animation: dash 1s linear infinite; }
    .anim-success { animation: pulseBorder 0.6s ease-in-out infinite; }
    @@keyframes dash { to { stroke-dashoffset: 100; } }
    @@keyframes pulseBorder { 0% { stroke-opacity: 1; stroke-width: 1.5; } 50% { stroke-opacity: 0.5; stroke-width: 3; } 100% { stroke-opacity: 1; stroke-width: 1.5; } }
</style>

@code {
    List<StationDto> stations = new();
    bool loading = true;
    HubConnection? hub;
    string whepBaseUrl = "";
    int qrCount = 0; int onlineCam = 0; int offlineCam = 0;

    Dictionary<string, OverlayBox> overlayBoxes = new();
    Dictionary<string, CancellationTokenSource> boxTimers = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = new Uri(Nav.BaseUri);
            whepBaseUrl = $"http://{uri.Host}:8889";
            stations = await StationService.GetStationsAsync() ?? new();
            CalcCamStatus();
            await InitSignalR();
        }
        catch (Exception ex) { Console.WriteLine($"Init Error: {ex.Message}"); }
        finally { loading = false; }
    }

    async Task InitSignalR()
    {
        try
        {
            hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/scanHub"), opt => { opt.Transports = HttpTransportType.WebSockets | HttpTransportType.LongPolling; })
                .WithAutomaticReconnect()
                .Build();

            // 1. Lắng nghe kết quả QR
            hub.On<string, string, double, double, double, double>("ScanResult", (stationName, code, x, y, w, h) =>
            {
                var station = stations.FirstOrDefault(s => s.Name.Equals(stationName, StringComparison.OrdinalIgnoreCase));
                if (station == null) return;

                if (code.StartsWith("Xin chào") || code.Contains("Login:"))
                    station.CurrentUsername = code.Replace("Xin chào", "").Replace("Login:", "").Replace("!", "").Trim();
                else if (code.Contains("ĐÃ ĐĂNG XUẤT"))
                    station.CurrentUsername = "---";

                if (station.QrCamera?.Name is string camName && !string.IsNullOrEmpty(code))
                {
                    bool isSuccess = code.StartsWith("Xin chào") || code.StartsWith("Login:") || code.StartsWith("🔴 REC");
                    if (isSuccess) qrCount++;

                    overlayBoxes[camName] = new OverlayBox { Text = code, X = x, Y = y, W = w, H = h, IsVisible = true, IsSuccess = isSuccess };
                    InvokeAsync(StateHasChanged);

                    if (boxTimers.TryGetValue(camName, out var old)) { old.Cancel(); old.Dispose(); boxTimers.Remove(camName); }
                    var cts = new CancellationTokenSource();
                    boxTimers[camName] = cts;
                    _ = Task.Delay(2500, cts.Token).ContinueWith(_ => {
                        if (!cts.Token.IsCancellationRequested && overlayBoxes.ContainsKey(camName)) {
                            overlayBoxes[camName].IsVisible = false;
                            InvokeAsync(StateHasChanged);
                        }
                    }, TaskScheduler.Default);
                }
            });

            // 2. Lắng nghe trạng thái quay (Update trực tiếp vào Model)
            hub.On<string, bool>("UpdateRecordingStatus", (stationName, isRecording) =>
            {
                var station = stations.FirstOrDefault(s => s.Name == stationName);
                if (station != null)
                {
                    station.IsRecording = isRecording;
                    InvokeAsync(StateHasChanged);
                }
            });

            await hub.StartAsync();
        }
        catch (Exception ex) { Console.WriteLine("SignalR Error: " + ex.Message); }
    }

    void CalcCamStatus() 
    { 
        onlineCam = 0; offlineCam = 0;
        foreach (var s in stations)
        {
            if (s.OverviewCamera != null) onlineCam++; else offlineCam++;
            if (s.QrCamera != null) onlineCam++; else offlineCam++;
        }
    }

    public async ValueTask DisposeAsync() { if (hub != null) await hub.DisposeAsync(); }

    public class OverlayBox { public string Text { get; set; } = ""; public double X { get; set; } public double Y { get; set; } public double W { get; set; } public double H { get; set; } public bool IsVisible { get; set; } = false; public bool IsSuccess { get; set; } = false; }
}