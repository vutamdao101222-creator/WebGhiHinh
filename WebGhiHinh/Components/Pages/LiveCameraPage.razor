@page "/live"
@using Microsoft.AspNetCore.SignalR.Client
@using WebGhiHinh.DTOs
@using WebGhiHinh.Services
@using WebGhiHinh.Components.Shared
@using Microsoft.AspNetCore.Http.Connections
@inject StationService StationService
@inject NavigationManager Nav
@implements IAsyncDisposable

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Live Control Center</PageTitle>

@* LOAD BOOTSTRAP & ICONS *@
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid p-3 main-container">
    
    @* --- DASHBOARD STATS --- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 col-xl">
            <div class="card bg-info text-dark h-100 shadow-sm border-0">
                <div class="card-body p-2 d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-activity"></i></div>
                    <div>
                        <div class="small opacity-75 fw-bold">CHẾ ĐỘ</div>
                        <div class="fs-4 fw-bold">Realtime (WHEP)</div> </div>
                </div>
            </div>
        </div>
    </div>

    @* --- DANH SÁCH MÁY (CAMERA GRID) --- *@
    @if (loading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-secondary py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="text-white-50">Đang kết nối hệ thống...</p>
        </div>
    }
    else if (stations != null)
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4 fade-in">
            @foreach (var st in stations)
            {
                <div class="col">
                    <div class="card h-100 shadow border-0 bg-dark station-card">
                        
                        @* HEADER CARD *@
                        <div class="card-header border-0 py-2 d-flex justify-content-between align-items-center bg-gradient-header">
                            <span class="text-white fw-bold">
                                <i class="bi bi-hdd-network me-2"></i>@(st.Name ?? "Unknown")
                            </span>
                            
                            @if(!string.IsNullOrEmpty(st.CurrentUsername) && st.CurrentUsername != "---") 
                            {
                                <span class="badge bg-danger shadow-sm animate-pulse">
                                    <i class="bi bi-person-fill"></i> @st.CurrentUsername
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary opacity-50">Chưa đăng nhập</span>
                            }
                        </div>

                        <div class="card-body p-0">
                            <div class="row g-0">
                                @* 2. CAM TOÀN CẢNH *@
                                <div class="col-6 border-end border-secondary">
                                    <div class="cam-box @(st.OverviewCamera != null ? "online" : "offline")">
                                        <div class="cam-badge">TOÀN CẢNH</div>
                                        @if (st.OverviewCamera != null)
                                        {
                                            @* 🔥 DÙNG WhepVideo THAY VÌ HlsVideo *@
                                            <WhepVideo src="@($"{whepBaseUrl}/{st.OverviewCamera.Name}/whep")"></WhepVideo>
                                        }
                                        else { <div class="no-signal"><span>NO SIGNAL</span></div> }
                                    </div>
                                </div>

                                @* 3. CAM QR (CÓ SVG OVERLAY) *@
                                <div class="col-6">
                                    <div class="cam-box @(st.QrCamera != null ? "online" : "offline")">
                                        <div class="cam-badge">QR CAM</div>
                                        @if (st.QrCamera != null)
                                        {
                                            @* 🔥 DÙNG WhepVideo *@
                                            <WhepVideo src="@($"{whepBaseUrl}/{st.QrCamera.Name}/whep")"></WhepVideo>

                                            @* SVG OVERLAY *@
                                            <svg class="qr-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                                                                                                @if (overlayBoxes.TryGetValue(st.QrCamera.Name, out var box) && box.IsVisible)
                                                {
                                                    <g>
                                                        <text x="@(box.X + 1)" y="@(box.Y - 2)" 
                                                              fill="white" 
                                                              font-size="5" 
                                                              font-weight="bold" 
                                                              font-family="Arial">
                                                            @box.Text
                                                        </text>
                                                    </g>}
                                                 </svg>
                                        }
                                        else { <div class="no-signal"><span>NO CONFIG</span></div> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    :root { --bg-dark: #0f172a; --card-bg: #1e293b; }
    body { background-color: var(--bg-dark); }
    .main-container { min-height: 100vh; color: #e2e8f0; }
    .bg-gradient-header { background: linear-gradient(90deg, #1e40af 0%, #3b82f6 100%); }
    .station-card { background-color: var(--card-bg) !important; overflow: hidden; }
    
    .cam-box { position: relative; width: 100%; padding-top: 56.25%; background: #000; overflow: hidden; }
    
    /* Ép Video con full màn hình */
    ::deep video { position: absolute; top: 0; left: 0; width: 100% !important; height: 100% !important; object-fit: fill; }

    .cam-box .no-signal { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ef4444; font-weight: bold; font-size: 0.8rem; }
    .cam-badge { position: absolute; top: 4px; left: 4px; z-index: 5; background: rgba(0,0,0,0.7); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; }

    /* SVG Overlay Styles */
    .qr-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        z-index: 10; pointer-events: none;
    }

    .anim-scan { animation: dash 1s linear infinite; }
    .anim-success { animation: pulseBorder 0.5s ease-in-out infinite; }

    @@keyframes dash { to { stroke-dashoffset: 100; } }
    @@keyframes pulseBorder { 
        0% { stroke-opacity: 1; stroke-width: 1.5; } 
        50% { stroke-opacity: 0.5; stroke-width: 3; } 
        100% { stroke-opacity: 1; stroke-width: 1.5; } 
    }
    
    .fade-in { animation: fadeIn 0.5s ease-out; }
    .animate-pulse { animation: pulse 2s infinite; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }
</style>

@code {
    List<StationDto> stations = new();
    bool loading = true;
    HubConnection? hub;
    string whepBaseUrl = ""; // 🔥 ĐỔI TÊN BIẾN CHO RÕ RÀNG
    int qrCount = 0; int onlineCam = 0; int offlineCam = 0;

    Dictionary<string, OverlayBox> overlayBoxes = new();
    Dictionary<string, CancellationTokenSource> boxTimers = new();

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var uri = new Uri(Nav.BaseUri);
            // 🔥 CỔNG 8889 CHO WHEP
            whepBaseUrl = $"http://{uri.Host}:8889"; 

            var result = await StationService.GetStationsAsync();
            stations = result ?? new List<StationDto>();
            
            CalcCamStatus();
            await InitSignalR();
        }
        catch (Exception ex) { Console.WriteLine($"Init Error: {ex.Message}"); }
        finally { loading = false; }
    }

    async Task InitSignalR()
    {
        try {
            hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/scanHub"), opt => {
                    opt.Transports = HttpTransportType.WebSockets | HttpTransportType.LongPolling;
                })
                .WithAutomaticReconnect()
                .Build();

            hub.On<string, string, double, double, double, double>("ScanResult", 
                (stationName, code, x, y, w, h) => 
            {
                // 🔥 KHÔNG CẦN DELAY NỮA VÌ WHEP NHANH TỨC THÌ
                // if (!string.IsNullOrEmpty(code)) await Task.Delay(hlsDelayMs); -> BỎ

                var station = stations.FirstOrDefault(s => s.Name.Equals(stationName, StringComparison.OrdinalIgnoreCase));
                
                if (station != null) 
                {
                    if (code.StartsWith("Xin chào") || code.Contains("Login:"))
                    {
                        string newName = code.Replace("Xin chào", "").Replace("Login:", "").Replace("!", "").Trim();
                        station.CurrentUsername = newName;
                        InvokeAsync(StateHasChanged);
                    }
                    else if (code.Contains("ĐÃ ĐĂNG XUẤT"))
                    {
                         station.CurrentUsername = "---";
                         InvokeAsync(StateHasChanged);
                    }

                    if (station.QrCamera != null && !string.IsNullOrEmpty(station.QrCamera.Name)) 
                    {
                        var camName = station.QrCamera.Name;
                        if (string.IsNullOrEmpty(code)) return;

                        bool isSuccess = code.StartsWith("Xin chào") || code.StartsWith("Login:") || code.StartsWith("🔴 REC");
                        
                        var box = new OverlayBox { 
                            Text = code, X = x, Y = y, W = w, H = h, 
                            IsVisible = true, IsSuccess = isSuccess 
                        };
                        
                        overlayBoxes[camName] = box;
                        InvokeAsync(StateHasChanged);

                        if (boxTimers.TryGetValue(camName, out var oldToken)) { oldToken.Cancel(); oldToken.Dispose(); boxTimers.Remove(camName); }
                        var cts = new CancellationTokenSource();
                        boxTimers[camName] = cts;

                        _ = Task.Delay(2000, cts.Token).ContinueWith(_ => {
                            if (!cts.Token.IsCancellationRequested && overlayBoxes.ContainsKey(camName))
                            {
                                overlayBoxes[camName].IsVisible = false;
                                InvokeAsync(StateHasChanged);
                            }
                        }, TaskScheduler.Default);
                    }
                }
            });
            await hub.StartAsync();
        } catch (Exception ex) { Console.WriteLine("SignalR Error: " + ex.Message); }
    }

    void CalcCamStatus()
    {
        if (stations == null) return;
        onlineCam = 0; offlineCam = 0;
        foreach (var s in stations)
        {
            if (s.OverviewCamera != null) onlineCam++; else offlineCam++;
            if (s.QrCamera != null) onlineCam++; else offlineCam++;
        }
    }

    public async ValueTask DisposeAsync() 
    { 
        if (hub != null) await hub.DisposeAsync();
    }
    
    public class OverlayBox { 
        public string Text { get; set; } = ""; 
        public double X { get; set; } 
        public double Y { get; set; } 
        public double W { get; set; } 
        public double H { get; set; } 
        public bool IsVisible { get; set; } = false;
        public bool IsSuccess { get; set; } = false; 
    }
}