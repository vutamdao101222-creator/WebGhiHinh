@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WebGhiHinh.Data
@using WebGhiHinh.Models
@using System.ComponentModel.DataAnnotations

@* 👇 Bắt buộc có quyền Admin mới vào được *@
@attribute [Authorize(Roles = "admin")]

@inject AppDbContext DbContext
@inject IJSRuntime JS
@inject NavigationManager Nav

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Quản lý Tài khoản</PageTitle>

<div class="page-container fade-in">
    <div class="page-header">
        <h1>👥 Quản lý Tài khoản</h1>
        <div class="header-actions">
            <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("/admin")'>⬅ Quay lại</button>
            <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">+ Thêm User</button>
            <a href="/account/logout" class="btn btn-warning btn-sm">Đăng xuất</a>
        </div>
    </div>

    <div class="page-section">
        @if (!string.IsNullOrEmpty(uiMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert" style="margin: 20px;">
                @uiMessage
                <button type="button" class="btn-close" @onclick='() => uiMessage = ""'></button>
            </div>
        }

        @if (users == null)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner"></div>
            </div>
        }
        else if (users.Count == 0)
        {
            <p class="text-muted text-center py-5">Chưa có tài khoản nào trong hệ thống.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th style="width:50px;">ID</th>
                            <th>Username</th>
                            <th>Họ tên</th>
                            <th>Mã NV</th>
                            <th>Payload QR</th>
                            <th style="width:120px;">Vai trò</th>
                            <th style="width:150px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr>
                                <td>@u.Id</td>
                                <td><strong>@u.Username</strong></td>
                                <td>@u.FullName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(u.EmployeeCode))
                                    {
                                        <span class="badge bg-light text-dark border">@u.EmployeeCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>

                                <td>
                                    @{
                                        // Tạo chuỗi Payload QR tại chỗ (Logic: EMPLOYEE:ID:CODE)
                                        var payload = GenerateQrPayload(u);
                                    }
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="small text-muted text-truncate" style="max-width: 150px;" title="@payload">
                                            @payload
                                        </div>
                                        <button class="btn btn-sm btn-outline-success py-0 px-1"
                                                title="Copy Payload"
                                                @onclick="() => CopyToClipboard(payload, u.Username)">
                                            📋
                                        </button>
                                        <button class="btn btn-sm btn-outline-dark py-0 px-1"
                                                title="Xem QR Code"
                                                @onclick="() => ShowEmployeeQr(u)">
                                            🖨️
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    @if (u.Role == "admin")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (u.Role == "admin1")
                                    {
                                        <span class="badge bg-warning text-dark">Admin 1</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">User</span>
                                    }
                                </td>

                                <td>
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => OpenEditModal(u)">Sửa</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(u)">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="currentUser" OnValidSubmit="SaveUser">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(currentUser.Id == 0 ? "Tạo Tài khoản mới" : "Cập nhật Tài khoản")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tên đăng nhập</label>
                            <InputText class="form-control" @bind-Value="currentUser.Username" disabled="@(currentUser.Id != 0)" />
                            <ValidationMessage For="@(() => currentUser.Username)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu @(currentUser.Id != 0 ? "(Để trống nếu không đổi)" : "")</label>
                            <InputText type="password" class="form-control" @bind-Value="passwordInput" />
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Họ tên</label>
                                <InputText class="form-control" @bind-Value="currentUser.FullName" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Mã NV</label>
                                <InputText class="form-control" @bind-Value="currentUser.EmployeeCode" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <InputText class="form-control" @bind-Value="currentUser.Address" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Vai trò</label>
                            <InputSelect class="form-select" @bind-Value="currentUser.Role">
                                <option value="user">User (Nhân viên)</option>
                                <option value="admin">Admin (Toàn quyền)</option>
                                <option value="admin1">Admin 1 (Chỉ xem Video/Live)</option>
                            </InputSelect>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger">@errorMsg</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu lại</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showQrModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">QR Nhân viên</h5>
                    <button type="button" class="btn-close" @onclick="() => showQrModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    @if (selectedUserForQr != null)
                    {
                        <img src="@($"/api/users/{selectedUserForQr.Id}/employee-qr-image")"
                             alt="QR Code"
                             style="max-width:100%; height:auto; border: 1px solid #ddd; padding: 5px;" />
                        
                        <div class="mt-2 fw-bold">@selectedUserForQr.FullName</div>
                        <div class="small text-muted">@selectedUserForQr.EmployeeCode</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Model dùng cho form
    public class UserViewModel
    {
        public int Id { get; set; }
        
        [Required(ErrorMessage = "Vui lòng nhập Username")]
        public string Username { get; set; } = "";
        public string? FullName { get; set; }
        public string? EmployeeCode { get; set; }
        public string? Address { get; set; }
        public string Role { get; set; } = "user";
    }

    private List<UserViewModel>? users;
    private UserViewModel currentUser = new();
    private User? selectedUserForQr; // User đang xem QR
    
    private bool showModal = false;
    private bool showQrModal = false;
    private string passwordInput = "";
    private string errorMsg = "";
    private string uiMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Load danh sách user trực tiếp từ DB khi trang mở
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        // 👇 Gọi trực tiếp DB Context, không qua HTTP Client
        // Vì code này chạy trên Server, nên truy cập DB rất nhanh
        var dbUsers = await DbContext.Users.OrderByDescending(u => u.Id).ToListAsync();
        
        users = dbUsers.Select(u => new UserViewModel
        {
            Id = u.Id,
            Username = u.Username,
            FullName = u.FullName,
            EmployeeCode = u.EmployeeCode,
            Address = u.Address,
            Role = u.Role ?? "user"
        }).ToList();
    }

    // --- LOGIC TẠO / SỬA USER ---
    private void OpenCreateModal()
    {
        currentUser = new UserViewModel { Role = "user" };
        passwordInput = "";
        errorMsg = "";
        showModal = true;
    }

    private void OpenEditModal(UserViewModel u)
    {
        currentUser = new UserViewModel
        {
            Id = u.Id,
            Username = u.Username,
            FullName = u.FullName,
            EmployeeCode = u.EmployeeCode,
            Address = u.Address,
            Role = u.Role
        };
        passwordInput = ""; // Reset pass
        errorMsg = "";
        showModal = true;
    }

    private async Task SaveUser()
    {
        errorMsg = "";
        try 
        {
            if (currentUser.Id == 0) // Tạo mới
            {
                if (string.IsNullOrWhiteSpace(passwordInput))
                {
                    errorMsg = "Vui lòng nhập mật khẩu cho tài khoản mới.";
                    return;
                }

                // Check trùng username
                if (await DbContext.Users.AnyAsync(u => u.Username == currentUser.Username))
                {
                    errorMsg = "Tên đăng nhập đã tồn tại!";
                    return;
                }

                var newUser = new User
                {
                    Username = currentUser.Username,
                    PasswordHash = passwordInput, // ⚠️ Lưu ý: Nên mã hóa MD5/BCrypt ở đây
                    FullName = currentUser.FullName,
                    EmployeeCode = currentUser.EmployeeCode,
                    Address = currentUser.Address,
                    Role = currentUser.Role
                };

                DbContext.Users.Add(newUser);
                await DbContext.SaveChangesAsync();
                uiMessage = $"✅ Đã tạo user {newUser.Username}";
            }
            else // Cập nhật
            {
                var user = await DbContext.Users.FindAsync(currentUser.Id);
                if (user != null)
                {
                    user.FullName = currentUser.FullName;
                    user.EmployeeCode = currentUser.EmployeeCode;
                    user.Address = currentUser.Address;
                    user.Role = currentUser.Role;
                    
                    // Chỉ đổi pass nếu người dùng nhập
                    if (!string.IsNullOrWhiteSpace(passwordInput))
                    {
                        user.PasswordHash = passwordInput;
                    }

                    await DbContext.SaveChangesAsync();
                    uiMessage = $"✅ Đã cập nhật user {user.Username}";
                }
            }

            showModal = false;
            await LoadUsers(); // Reload lại danh sách
        }
        catch (Exception ex)
        {
            errorMsg = "Lỗi hệ thống: " + ex.Message;
        }
    }

    private async Task DeleteUser(UserViewModel u)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa {u.Username}?")) return;

        var user = await DbContext.Users.FindAsync(u.Id);
        if (user != null)
        {
            DbContext.Users.Remove(user);
            await DbContext.SaveChangesAsync();
            uiMessage = $"🗑️ Đã xóa user {u.Username}";
            await LoadUsers();
        }
    }

    private void CloseModal() => showModal = false;

    // --- LOGIC QR CODE ---
    
    // Hàm tạo chuỗi payload QR (Logic phải khớp với QrScanWorker)
    private string GenerateQrPayload(UserViewModel u)
    {
        // Ví dụ format: "EMPLOYEE:{ID}:{CODE}"
        // Nếu bạn dùng format khác, hãy sửa ở đây
        if (string.IsNullOrEmpty(u.EmployeeCode)) return "";
        return $"EMPLOYEE:{u.Id}:{u.EmployeeCode}";
    }

    private async Task CopyToClipboard(string text, string username)
    {
        if (string.IsNullOrEmpty(text))
        {
            uiMessage = $"⚠️ User {username} chưa có Mã NV để tạo QR.";
            return;
        }
        
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            uiMessage = $"✅ Đã copy payload của {username}";
        }
        catch
        {
            uiMessage = "❌ Không thể copy (Lỗi trình duyệt)";
        }
    }

    private void ShowEmployeeQr(UserViewModel vm)
    {
        // Chuyển đổi ViewModel sang Model User tạm để hiển thị
        selectedUserForQr = new User 
        { 
            Id = vm.Id, 
            FullName = vm.FullName, 
            EmployeeCode = vm.EmployeeCode 
        };
        showQrModal = true;
    }
}